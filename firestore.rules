rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Associé = droit "team" posé par le serveur après vérification de la liste ALLOWED_EMAILS.
    function team() {
      return request.auth != null && request.auth.token.team == true && request.auth.token.email_verified == true;
    }
    // Les adresses de reprise des portes ne sont jamais lisibles depuis un navigateur.
    match /jobs/{id}/private/{doc} { allow read, write: if false; }
    // Lecture réservée aux associés. Les écritures passent par les routes du serveur (qui ignorent ces règles).
    match /{document=**} {
      allow read: if team();
      allow write: if false;
    }
  }
}
