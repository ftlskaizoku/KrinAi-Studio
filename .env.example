# Adresses autorisées (les 3 associés), séparées par des virgules
ALLOWED_EMAILS=adresse1@gmail.com,adresse2@gmail.com,adresse3@gmail.com
# Adresse publique de l'app (en local : http://localhost:3000)
APP_URL=http://localhost:3000
# n8n : en local avec le faux n8n, http://localhost:4000
N8N_URL=http://localhost:4000
# Secret partagé avec Zoum, dans les deux sens (long et aléatoire)
N8N_SHARED_SECRET=dev-secret
# Clé de compte de service Firebase, JSON sur UNE seule ligne
FIREBASE_SERVICE_ACCOUNT={}
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
